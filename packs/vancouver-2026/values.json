{
  "meta": {
    "pack": "vancouver-2026",
    "currency": "CAD",
    "ft2_per_m2": 10.764,
    "basis": "Capitalised value per m2 of gross floor area, 2026 dollars, before construction cost. Each row keeps its market inputs so the value can be recomputed (see core/validate_data.js). Order-of-magnitude only.",
    "methods": {
      "sale": "price_ft2 x 10.764 x efficiency x (1 - selling_cost)",
      "income": "rent_ft2_yr x 10.764 x (1 - vacancy) x (1 - leakage) x (1 - opex_ratio) - opex_ft2_yr x 10.764, / cap_rate x efficiency (monthly rent x 12)",
      "per_key": "noi_per_key / cap_rate / m2_per_key",
      "visitors": "visitors x ticket x (1 + fnb_uplift) x margin / cap_rate / deck_area_m2",
      "per_stall_sale": "price_per_stall / m2_per_stall",
      "per_stall_income": "rate_month x 12 x utilisation x margin / cap_rate / m2_per_stall",
      "stated": "value given directly; no inputs to recompute",
      "none": "earns nothing (public or support); cost only",
      "user": "no default: user to supply"
    },
    "row_count": 39
  },
